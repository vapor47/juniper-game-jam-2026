[node name="GridFrame" type="MarginContainer" parent="MarginContainer/VBodyContainer/SlotsBodyContainer/PanelContainer/GridStack" unique_id=658891028]
editor_description = "Zero-margin host so PaylineOverlay can be added over ReelColumns
without a VBox laying it out as another row. A MarginContainer fits every child
to the same rect, so the overlay covers exactly the grid."
