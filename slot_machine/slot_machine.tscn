[node name="SlotsBodyContainer" type="HBoxContainer" parent="MarginContainer/VBodyContainer" unique_id=1893252390]
editor_description = "PaylinePanel | reel grid | LeverBay.
Centred and hugging its content: the two flanks are equal width so the grid
lands on the screen centre without the row stretching to fill."
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
theme_override_constants/separation = 20
alignment = 1

[node name="LeftFlank" type="VBoxContainer" parent="MarginContainer/VBodyContainer/SlotsBodyContainer" unique_id=1120449313]
editor_description = "Fixed-size readout above the payline list. The readout must not
share a container with the rows, or its text changing on hover would resize
the list and shuffle rows out from under the cursor."
